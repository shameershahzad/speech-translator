{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "speech-translator-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "speech-translator-backend",
      "runtimeExecutable": "backend/venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8001", "--reload", "--app-dir", "backend"],
      "port": 8001
    }
  ]
}
